NEXT_PUBLIC_GATEWAY_URL=http://localhost:3001
NEXT_PUBLIC_ENGINE_URL=http://localhost:8000

# ── Auth (Auth.js v5) ─────────────────────────────────────────────────────
# Postgres connection string for Neon / Vercel Postgres. Run
# `psql "$DATABASE_URL" -f src/lib/db/schema.sql` once to create the tables.
DATABASE_URL=

# Generate with: npx auth secret   (or `openssl rand -base64 33`)
AUTH_SECRET=

# Google OAuth client — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# (add your production URL's equivalent too once deployed)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
