PORT=3001
ENGINE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Milestone 5: Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
AI_FEATURES_ENABLED=false

# Adobe PDF Services (Word -> PDF conversion)
PDF_SERVICES_CLIENT_ID=
PDF_SERVICES_CLIENT_SECRET=

# Object storage for uploaded images. Leave unset for local-FS storage (dev
# only — requires gateway and engine to share a filesystem). Set to
# "cloudinary" (free tier, no card required — the default choice for this
# project) or "r2" (Cloudflare, needs a card on file) in any deployment where
# gateway and engine are separate services (e.g. Render): the engine
# downloads each image from its public URL instead of reading a path that
# only ever existed on the gateway's own disk.
OBJECT_STORAGE=

# Cloudinary (cloudinary.com — free tier, no card needed). All three values
# are shown on your dashboard home page after signup.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cloudflare R2 (alternative — requires a card on file to activate, even on
# the free tier).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
