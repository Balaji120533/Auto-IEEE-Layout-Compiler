# PDF conversion (optional — .docx output always works without this).
# LibreOffice is used automatically if installed and found on PATH.
# Otherwise, cloud backends are tried in order: CloudConvert first, then
# Adobe PDF Services as a fallback if CloudConvert is unavailable or fails.
# Both upload your document to the respective provider's servers.
CLOUDCONVERT_API_KEY=

# Adobe PDF Services (free tier: 500 document transactions/month).
PDF_SERVICES_CLIENT_ID=
PDF_SERVICES_CLIENT_SECRET=

# Force a specific backend instead of auto-detecting: "libreoffice" | "cloudconvert" | "adobe"
PDF_BACKEND=
